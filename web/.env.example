# Optional. The dashboard browses the research database in Supabase without this file.
# Copy it to ".env" (same folder) to turn on photo scanning, material lookup, AI answers, chat,
# the Pipeline page and editing.
# ".env" is never committed.

# The fire-intel backend. Get the address and token from Gus.
API_BASE_URL=http://127.0.0.1:8080
API_AUTH_TOKEN=

# PORT=3100
# READ_ONLY=true   # set this on any public deployment: turns off ingest, extraction and editing

# Photo scanning (Burn Scan). The site identifies photos itself until the backend ships /ai/scan.
# VISION_PROVIDER=ollama          # ollama (default) or anthropic
# VISION_FALLBACK=none            # anthropic or none (default): tried once if the provider fails
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_VISION_MODEL=llama3.2-vision
# ANTHROPIC_MODEL=claude-haiku-5-5
# ANTHROPIC_WORKSPACE_ID=        # only for keys that are not scoped to one workspace
# Never commit a real key. ".env" is ignored by git.
ANTHROPIC_API_KEY=
